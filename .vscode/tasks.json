{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++",
      "args": [
  "src/main.cpp",
  "src/utils.cpp",
  "-Ilibs/include",
  "-Ilibs/freeglut/include",
        "-Llibs/freeglut/lib/x64",
        "-Llibs",
        "-lglew32",
        "-lfreeglut",
        "-lopengl32",
        "-lglu32",
        "-o", "app.exe"
      ],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
